{
  "expo": {
    "name": "HibTy",
    "slug": "hibty",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b14",
    "splash": { "image": "./assets/icon.png", "resizeMode": "contain", "backgroundColor": "#0b0b14" },
    "plugins": [
      ["expo-notifications", { "icon": "./assets/favicon.png", "color": "#4f8cff" }]
    ],
    "android": {
      "package": "com.pavan.hibty",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0b0b14" },
      "permissions": [
        "POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM", "USE_EXACT_ALARM",
        "VIBRATE", "WAKE_LOCK", "RECEIVE_BOOT_COMPLETED", "RECORD_AUDIO"
      ]
    }
  }
}
